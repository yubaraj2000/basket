# Copy this file to .env.local and fill in the values from your Supabase project:
#   Project URL:      Project Settings → Data API (or API)
#   Publishable key:  Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
# Both are safe to ship in the app. Never put the database password or a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
